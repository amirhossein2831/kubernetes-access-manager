        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "access-history"
        },
        "query": {
          "refId": "A",
          "queryType": "dsl",
          "editorType": "code",
          "timeField": "observed_at",
          "query": "{\"size\":0,\"query\":{\"range\":{\"observed_at\":{\"gte\":\"$__from\",\"lte\":\"$__to\",\"format\":\"epoch_millis\"}}},\"aggs\":{\"snapshots\":{\"terms\":{\"field\":\"snapshot_id\",\"size\":100,\"order\":{\"latest\":\"desc\"}},\"aggs\":{\"latest\":{\"max\":{\"field\":\"observed_at\"}},\"expected\":{\"max\":{\"field\":\"expected_users\"}},\"minimum\":{\"min\":{\"field\":\"expected_users\"}},\"metadata_count\":{\"value_count\":{\"field\":\"expected_users\"}},\"users\":{\"scripted_metric\":{\"init_script\":\"state.users = new HashSet();\",\"map_script\":\"state.users.add(doc['username'].value);\",\"combine_script\":\"return state.users;\",\"reduce_script\":\"def users = new HashSet(); for (s in states) { users.addAll(s); } return users.size();\"}},\"complete\":{\"bucket_selector\":{\"buckets_path\":{\"n\":\"users.value\",\"expected\":\"expected\",\"minimum\":\"minimum\",\"docs\":\"_count\",\"metadata\":\"metadata_count\"},\"script\":\"params.expected > 0 && params.expected == params.minimum && params.n == params.expected && params.docs == params.expected && params.metadata == params.docs\"}}}}}}",
          "bucketAggs": [
            {
              "id": "snapshots",
              "type": "terms",
              "field": "snapshot_id"
            }
          ],
          "metrics": [
            {
              "id": "expected",
              "type": "max",
              "field": "expected_users"
