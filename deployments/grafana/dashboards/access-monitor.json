{
  "uid": "access-monitor",
  "title": "Kubernetes access — permissions and monitor health",
  "description": "RBAC observations and service health. Dropdowns cover recorded users/snapshots and configured sensitive policy values. API group is empty for core. UI saves persist in Grafana, not this provisioning file.",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "timezone": "utc",
  "time": {"from":"now-6h","to":"now"},
  "tags": ["security","rbac"],
  "templating": {"list":[
    {"name":"username","label":"Access: user","type":"query","datasource":{"type":"elasticsearch","uid":"access-history"},"query":"{\"find\":\"terms\",\"field\":\"username\",\"size\":1000}","refresh":2,"sort":1,"multi":false,"includeAll":true,"allValue":"*","current":{"text":"All","value":"$__all"}},
    {"name":"snapshot","label":"Access: snapshot ID","type":"query","datasource":{"type":"elasticsearch","uid":"access-history"},"query":"{\"find\":\"terms\",\"field\":\"snapshot_id\",\"size\":1000}","refresh":2,"sort":1,"multi":false,"includeAll":true,"allValue":"*","current":{"text":"All","value":"$__all"}},
    {"name":"api_group","label":"Access: API group (empty means core)","type":"textbox","query":"","current":{"text":"","value":""}},
    {"name":"resource","label":"Access: policy resource","type":"query","datasource":{"type":"prometheus","uid":"prometheus"},"query":"label_values(k8s_cluster_wide_sensitive_access_users_count, resource)","refresh":2,"sort":1,"multi":false,"current":{"text":"secrets","value":"secrets"}},
    {"name":"verb","label":"Access: policy verb","type":"query","datasource":{"type":"prometheus","uid":"prometheus"},"query":"label_values(k8s_cluster_wide_sensitive_access_users_count, verb)","refresh":2,"sort":1,"multi":false,"current":{"text":"get","value":"get"}},
    {"name":"namespace","label":"Access: policy namespace","type":"query","datasource":{"type":"prometheus","uid":"prometheus"},"query":"label_values(k8s_namespace_sensitive_access_users_count, namespace)","refresh":2,"sort":1,"multi":false,"includeAll":true,"allValue":"*","current":{"text":"All","value":"$__all"}}
  ]},
  "panels": [
    {"id":19,"type":"stat","title":"Elasticsearch query check — access records","description":"Number of access records in the selected time range. A returned count, including zero, confirms the authenticated Grafana-to-Elasticsearch query works. An error or missing result is not healthy. This is a live query check, not cluster health or historical uptime.","datasource":{"type":"elasticsearch","uid":"access-history"},"gridPos":{"x":20,"y":1,"w":4,"h":4},"targets":[{"refId":"A","query":"*","queryType":"lucene","metrics":[{"id":"1","type":"count"}],"bucketAggs":[{"id":"2","type":"date_histogram","field":"observed_at","settings":{"interval":"auto","min_doc_count":"0"}}],"timeField":"observed_at"}],"options":{"reduceOptions":{"calcs":["sum"],"fields":"","values":false}},"fieldConfig":{"defaults":{"unit":"short","decimals":0},"overrides":[]}},
    {"id":1,"type":"row","title":"Service health","collapsed":false,"gridPos":{"x":0,"y":0,"w":24,"h":1}},
    {"id":2,"type":"stat","title":"Application scrape availability","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":1,"w":5,"h":4},"targets":[{"refId":"A","expr":"up{job=\"access-monitor\"}","instant":true}]},
    {"id":3,"type":"stat","title":"Observation age (seconds)","description":"No result before the first successful collection. Output and delivery have separate success boundaries.","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":5,"y":1,"w":5,"h":4},"targets":[{"refId":"A","expr":"time() - access_monitor_last_successful_observation_timestamp_seconds","instant":true}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":4,"type":"stat","title":"Successful observation exists","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":10,"y":1,"w":5,"h":4},"targets":[{"refId":"A","expr":"access_monitor_has_observation","instant":true}]},
    {"id":5,"type":"stat","title":"File report age (seconds)","description":"File write acceptance is not Elasticsearch acknowledgement.","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":15,"y":1,"w":5,"h":4},"targets":[{"refId":"A","expr":"time() - (access_monitor_last_full_file_report_timestamp_seconds > 0)","instant":true}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":6,"type":"timeseries","title":"Collection outcomes / 15 minutes","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":5,"w":8,"h":6},"targets":[{"refId":"A","expr":"sum by (result) (increase(access_monitor_collections_total[15m]))","legendFormat":"{{result}}"}]},
    {"id":7,"type":"timeseries","title":"Collection duration p95","description":"Estimated time within which 95% of collection attempts finish, using the last 30 minutes. Includes successful and failed attempts. Source values are seconds; Grafana may display a scaled time unit.","fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":8,"y":5,"w":8,"h":6},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le) (rate(access_monitor_collection_duration_seconds_bucket[30m])))","legendFormat":"p95 collection duration"}]},
    {"id":8,"type":"timeseries","title":"Output failures / 15 minutes","description":"Failed stdout/file report writes in each rolling 15-minute window. Zero means no recorded failures; missing telemetry also falls back to zero. Check monitor reachability and collection freshness separately. This does not measure Filebeat delivery.","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":16,"y":5,"w":8,"h":6},"targets":[{"refId":"A","expr":"sum by (sink) (increase(access_monitor_output_total{result=\"failure\"}[15m])) or on() vector(0)","legendFormat":"{{sink}}"}]},
    {"id":9,"type":"logs","title":"Monitor application logs and errors","description":"Monitor logs within the selected time range, not Kubernetes user activity. Expand an entry for error details. Old failures remain visible after recovery. Other stack services have separate container logs.","datasource":{"type":"elasticsearch","uid":"access-logs"},"gridPos":{"x":0,"y":11,"w":16,"h":6},"targets":[{"refId":"A","query":"*","queryType":"lucene","metrics":[{"id":"1","type":"logs","settings":{"limit":"100"}}],"bucketAggs":[],"timeField":"observed_at"}]},
    {"id":10,"type":"text","title":"Delivery and storage caveat","gridPos":{"x":16,"y":11,"w":8,"h":6},"options":{"mode":"markdown","content":"**Application scrape availability** means Prometheus can scrape the application, not that every collection or delivery succeeded. **Observation age** tells you how fresh the permissions are. **Application logs** show past errors within the selected time range, even after recovery. **Output failures** cover stdout and file writes, not Filebeat delivery to Elasticsearch. Permission records describe RBAC grants, not actions users performed. Sensitive counts cover all monitored users, regardless of the user filter above. Filebeat delivery is separate; inspect its container logs if records stop arriving."}},
    {"id":11,"type":"row","title":"Access — recorded observations, not continuous authorization","collapsed":false,"gridPos":{"x":0,"y":17,"w":24,"h":1}},
    {"id":12,"type":"logs","title":"Matching users and full grant provenance","description":"Correlated nested filtering. Default is core secrets/get. Resource, verb and namespace dropdowns cover the configured sensitive policy, not every recorded grant. Expand records for grants, restrictions and sources. Time range means observed at least once, not continuous access. Results limited to 500.","datasource":{"type":"elasticsearch","uid":"access-history"},"gridPos":{"x":0,"y":18,"w":24,"h":10},"targets":[{"refId":"A","queryType":"dsl","editorType":"code","timeField":"observed_at","metrics":[{"id":"1","type":"logs","settings":{"limit":"500"}}],"bucketAggs":[],"query":"{\"size\":500,\"sort\":[{\"observed_at\":\"desc\"}],\"query\":{\"bool\":{\"filter\":[{\"range\":{\"observed_at\":{\"gte\":\"$__from\",\"lte\":\"$__to\",\"format\":\"epoch_millis\"}}},{\"wildcard\":{\"username\":\"${username:raw}\"}},{\"wildcard\":{\"snapshot_id\":\"${snapshot:raw}\"}},{\"nested\":{\"path\":\"grants\",\"query\":{\"bool\":{\"filter\":[{\"terms\":{\"grants.api_group\":[\"${api_group:raw}\",\"*\"]}},{\"terms\":{\"grants.resource\":[\"${resource:raw}\",\"*\"]}},{\"terms\":{\"grants.verbs\":[\"${verb:raw}\",\"*\"]}},{\"bool\":{\"should\":[{\"wildcard\":{\"grants.namespace\":\"${namespace:raw}\"}},{\"terms\":{\"grants.scope\":[\"all_namespaces\",\"cluster\"]}}],\"minimum_should_match\":1}}]}}}}]}}}"}]},
    {"id":13,"type":"logs","title":"Selected user / snapshot — all recorded grants including empty users","description":"This panel does not apply the resource/verb/namespace filters. Expand each record to inspect original constraints and role/binding sources. Both access panels use observation time.","datasource":{"type":"elasticsearch","uid":"access-history"},"gridPos":{"x":0,"y":28,"w":24,"h":8},"targets":[{"refId":"A","queryType":"dsl","editorType":"code","timeField":"observed_at","metrics":[{"id":"1","type":"logs","settings":{"limit":"500"}}],"bucketAggs":[],"query":"{\"size\":500,\"query\":{\"bool\":{\"filter\":[{\"range\":{\"observed_at\":{\"gte\":\"$__from\",\"lte\":\"$__to\",\"format\":\"epoch_millis\"}}},{\"wildcard\":{\"username\":\"${username:raw}\"}},{\"wildcard\":{\"snapshot_id\":\"${snapshot:raw}\"}}]}}}"}]},
    {"id":14,"type":"row","title":"Sensitive access — unique monitored users (not filtered by access usernames)","collapsed":false,"gridPos":{"x":0,"y":36,"w":24,"h":1}},
    {"id":15,"type":"table","title":"Sensitive namespace user counts","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":37,"w":12,"h":8},"targets":[{"refId":"A","expr":"k8s_namespace_sensitive_access_users_count","instant":true,"format":"table"}]},
    {"id":16,"type":"table","title":"Cluster-wide sensitive user counts","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":37,"w":12,"h":8},"targets":[{"refId":"A","expr":"k8s_cluster_wide_sensitive_access_users_count","instant":true,"format":"table"}]},
    {"id":17,"type":"timeseries","title":"Sensitive namespace count history","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":45,"w":12,"h":7},"targets":[{"refId":"A","expr":"k8s_namespace_sensitive_access_users_count","legendFormat":"{{namespace}} {{verb}} {{resource}}"}]},
    {"id":18,"type":"timeseries","title":"Cluster-wide count history","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":45,"w":12,"h":7},"targets":[{"refId":"A","expr":"k8s_cluster_wide_sensitive_access_users_count","legendFormat":"{{verb}} {{resource}}"}]}
  ]
}
