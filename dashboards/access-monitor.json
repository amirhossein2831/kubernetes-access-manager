{
  "uid": "access-monitor",
  "title": "Kubernetes RBAC access monitor",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "timezone": "utc",
  "time": {"from":"now-6h","to":"now"},
  "tags": ["security","rbac"],
  "templating": {"list":[
    {"name":"username","label":"Access: user (exact or *)","type":"textbox","query":"*","current":{"text":"*","value":"*"}},
    {"name":"snapshot","label":"Access: snapshot ID (exact or *)","type":"textbox","query":"*","current":{"text":"*","value":"*"}},
    {"name":"api_group","label":"Access: API group (empty means core)","type":"textbox","query":"","current":{"text":"","value":""}},
    {"name":"resource","label":"Access: concrete resource","type":"textbox","query":"secrets","current":{"text":"secrets","value":"secrets"}},
    {"name":"verb","label":"Access: concrete verb","type":"textbox","query":"get","current":{"text":"get","value":"get"}},
    {"name":"namespace","label":"Access: namespace (exact or *)","type":"textbox","query":"*","current":{"text":"*","value":"*"}}
  ]},
  "panels": [
    {"id":1,"type":"row","title":"Service health","collapsed":false,"gridPos":{"x":0,"y":0,"w":24,"h":1}},
    {"id":2,"type":"stat","title":"Application scrape availability","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":1,"w":6,"h":4},"targets":[{"refId":"A","expr":"up{job=\"access-monitor\"}","instant":true}]},
    {"id":3,"type":"stat","title":"Observation age (seconds)","description":"No result before the first successful collection. Output and delivery have separate success boundaries.","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":6,"y":1,"w":6,"h":4},"targets":[{"refId":"A","expr":"time() - access_monitor_last_successful_observation_timestamp_seconds","instant":true}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":4,"type":"stat","title":"Successful observation exists","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":1,"w":6,"h":4},"targets":[{"refId":"A","expr":"access_monitor_has_observation","instant":true}]},
    {"id":5,"type":"stat","title":"File report age (seconds)","description":"File write acceptance is not Elasticsearch acknowledgement.","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":18,"y":1,"w":6,"h":4},"targets":[{"refId":"A","expr":"time() - (access_monitor_last_full_file_report_timestamp_seconds > 0)","instant":true}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":6,"type":"timeseries","title":"Collection outcomes / 15 minutes","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":5,"w":8,"h":6},"targets":[{"refId":"A","expr":"sum by (result) (increase(access_monitor_collections_total[15m]))","legendFormat":"{{result}}"}]},
    {"id":7,"type":"timeseries","title":"Collection duration p95","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":8,"y":5,"w":8,"h":6},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le) (rate(access_monitor_collection_duration_seconds_bucket[30m])))"}]},
    {"id":8,"type":"timeseries","title":"Output failures / 15 minutes","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":16,"y":5,"w":8,"h":6},"targets":[{"refId":"A","expr":"sum by (sink) (increase(access_monitor_output_total{result=\"failure\"}[15m]))","legendFormat":"{{sink}}"}]},
    {"id":9,"type":"logs","title":"Operational diagnostics","datasource":{"type":"elasticsearch","uid":"access-logs"},"gridPos":{"x":0,"y":11,"w":16,"h":6},"targets":[{"refId":"A","query":"*","queryType":"lucene","metrics":[{"id":"1","type":"logs","settings":{"limit":"100"}}],"bucketAggs":[],"timeField":"observed_at"}]},
    {"id":10,"type":"text","title":"Delivery and storage caveat","gridPos":{"x":16,"y":11,"w":8,"h":6},"options":{"mode":"markdown","content":"Filebeat delivery is independent of collection. Inspect Filebeat /stats on internal port 5066 and its container logs. No Filebeat Prometheus exporter is installed; application up does **not** prove delivery. Logs are bounded; Elasticsearch cleanup is manual. No successful observation yet and zero sensitive users are different states."}},
    {"id":11,"type":"row","title":"Access — recorded observations, not continuous authorization","collapsed":false,"gridPos":{"x":0,"y":17,"w":24,"h":1}},
    {"id":12,"type":"logs","title":"Matching users and full grant provenance","description":"Correlated nested filtering. Default is core secrets/get. Expand records for grants, restrictions and sources. Time range means observed at least once, not continuous access. Exact snapshot ID inspects one observation; visible documents do not prove full indexing. Results limited to 500.","datasource":{"type":"elasticsearch","uid":"access-history"},"gridPos":{"x":0,"y":18,"w":24,"h":10},"targets":[{"refId":"A","queryType":"dsl","editorType":"code","timeField":"observed_at","metrics":[{"id":"1","type":"logs","settings":{"limit":"500"}}],"bucketAggs":[],"query":"{\"size\":500,\"sort\":[{\"observed_at\":\"desc\"}],\"query\":{\"bool\":{\"filter\":[{\"range\":{\"observed_at\":{\"gte\":\"$__from\",\"lte\":\"$__to\",\"format\":\"epoch_millis\"}}},{\"wildcard\":{\"username\":${username:json}}},{\"wildcard\":{\"snapshot_id\":${snapshot:json}}},{\"nested\":{\"path\":\"grants\",\"query\":{\"bool\":{\"filter\":[{\"terms\":{\"grants.api_group\":[${api_group:json},\"*\"]}},{\"terms\":{\"grants.resource\":[${resource:json},\"*\"]}},{\"terms\":{\"grants.verbs\":[${verb:json},\"*\"]}},{\"bool\":{\"should\":[{\"wildcard\":{\"grants.namespace\":${namespace:json}}},{\"terms\":{\"grants.scope\":[\"all_namespaces\",\"cluster\"]}}],\"minimum_should_match\":1}}]}}}}]}}}"}]},
    {"id":13,"type":"logs","title":"Selected user / snapshot — all recorded grants including empty users","description":"This panel does not apply the resource/verb/namespace filters. Expand each record to inspect original constraints and role/binding sources. Both access panels use observation time.","datasource":{"type":"elasticsearch","uid":"access-history"},"gridPos":{"x":0,"y":28,"w":24,"h":8},"targets":[{"refId":"A","queryType":"dsl","editorType":"code","timeField":"observed_at","metrics":[{"id":"1","type":"logs","settings":{"limit":"500"}}],"bucketAggs":[],"query":"{\"size\":500,\"query\":{\"bool\":{\"filter\":[{\"range\":{\"observed_at\":{\"gte\":\"$__from\",\"lte\":\"$__to\",\"format\":\"epoch_millis\"}}},{\"wildcard\":{\"username\":${username:json}}},{\"wildcard\":{\"snapshot_id\":${snapshot:json}}}]}}}"}]},
    {"id":14,"type":"row","title":"Sensitive access — unique monitored users (not filtered by access usernames)","collapsed":false,"gridPos":{"x":0,"y":36,"w":24,"h":1}},
    {"id":15,"type":"table","title":"Sensitive namespace user counts","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":37,"w":12,"h":8},"targets":[{"refId":"A","expr":"k8s_namespace_sensitive_access_users_count","instant":true,"format":"table"}]},
    {"id":16,"type":"table","title":"Cluster-wide sensitive user counts","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":37,"w":12,"h":8},"targets":[{"refId":"A","expr":"k8s_cluster_wide_sensitive_access_users_count","instant":true,"format":"table"}]},
    {"id":17,"type":"timeseries","title":"Sensitive namespace count history","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":45,"w":12,"h":7},"targets":[{"refId":"A","expr":"k8s_namespace_sensitive_access_users_count","legendFormat":"{{namespace}} {{verb}} {{resource}}"}]},
    {"id":18,"type":"timeseries","title":"Cluster-wide count history","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":45,"w":12,"h":7},"targets":[{"refId":"A","expr":"k8s_cluster_wide_sensitive_access_users_count","legendFormat":"{{verb}} {{resource}}"}]}
  ]
}
